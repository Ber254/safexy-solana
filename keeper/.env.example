# RPC endpoint (defaults to devnet)
SOLANA_RPC_URL=https://api.devnet.solana.com
# Path to a keypair JSON file (array of 64 bytes). The keeper only pays tx fees;
# `expire` is permissionless and always pays out to the escrow's buyer.
KEEPER_KEYPAIR=./keeper.json
# Program id override (defaults to the one in the IDL / Anchor.toml)
PROGRAM_ID=
# Poll interval in milliseconds
POLL_INTERVAL_MS=30000
